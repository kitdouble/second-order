# Public URL people open in the browser. Passkeys are bound to this host.
APP_ORIGIN=http://localhost:5173
# Defaults to the hostname of APP_ORIGIN; set explicitly in production, e.g. secondorder.example.org
# RP_ID=localhost
# Participant-facing origin for experiments (must differ from APP_ORIGIN)
# RUN_ORIGIN=http://127.0.0.1:3000
API_PORT=3000
DB_PATH=data/second-order.db
# Extra allowed OAuth redirect URI prefixes, comma-separated (Claude, ChatGPT and localhost are built in)
# OAUTH_EXTRA_REDIRECTS=
# Prolific: the lab's API token (Prolific > Settings > API tokens). Without it the Prolific tools say it isn't connected.
# PROLIFIC_API_TOKEN=
# Optional: the Prolific project new studies go into (default: the token's default project)
# PROLIFIC_PROJECT_ID=
# Spending caps in GBP, including Prolific's fees and VAT; admins are exempt
# PROLIFIC_STUDY_CAP_GBP=150
# PROLIFIC_USER_MONTHLY_CAP_GBP=300
