{
  "hosting": {
    "site": "second-order-de65b",
    "public": "hosting/public",
    "rewrites": [
      {
        "source": "/api/ingest/**",
        "run": { "serviceId": "so-ingest", "region": "australia-southeast1" }
      },
      {
        "source": "/s/**",
        "destination": "/s/index.html"
      },
      {
        "source": "**",
        "run": { "serviceId": "so-web", "region": "australia-southeast1" }
      }
    ],
    "headers": [
      {
        "source": "/runtime/**",
        "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
      },
      {
        "source": "/s/**",
        "headers": [
          { "key": "X-Robots-Tag", "value": "noindex" },
          { "key": "Cache-Control", "value": "no-cache" }
        ]
      }
    ]
  }
}
